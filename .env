# Environment variables for ProTube application

# Database configuration
ENV_PROTUBE_DB_USER=admin
ENV_PROTUBE_DB_PASS=admin
ENV_PROTUBE_DB=tutube_db
ENV_PROTUBE_DB_HOST=localhost

# Google OAuth2 configuration
ENV_PROTUBE_GOOGLE_CLIENT_ID=your_google_client_id
ENV_PROTUBE_GOOGLE_CLIENT_SECRET=your_google_client_secret
